# Copy to .env and fill in for anything beyond local dev.

# Clerk — required.
# VITE_ prefix bakes the publishable key into the client bundle at build time.
# The secret key is server-side only; never expose it to the client.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public origin of the frontend (used in console-printed reset links)
CLIENT_ORIGIN=http://localhost:5173

# API port
PORT=3001

# Extra origins allowed to call the API, comma separated
TRUSTED_ORIGINS=

# SMTP (optional — booking emails; console fallback when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Flutterwave webhook (optional — set to the verif-hash you configure in the Flutterwave dashboard)
FLW_WEBHOOK_SECRET=
