# Copy to .env and fill in for anything beyond local dev.

# Better Auth — required in production (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Public origin of the frontend (used in console-printed reset links)
CLIENT_ORIGIN=http://localhost:5173

# API port
PORT=3001

# Extra origins allowed to call the API, comma separated
TRUSTED_ORIGINS=

# Google sign-in (optional — button activates when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
