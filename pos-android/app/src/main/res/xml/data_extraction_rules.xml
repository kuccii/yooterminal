<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The POS keeps bearer tokens in EncryptedSharedPreferences backed by the
         Android Keystore; those keys never leave the device. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
